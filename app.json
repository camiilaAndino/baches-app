{
  "expo": {
    "name": "Alerta Baches",
    "slug": "MiApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_app.png",
    "scheme": "miapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.alertabaches.miapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para marcar el punto exacto del reporte en el mapa.",
        "NSCameraUsageDescription": "Usamos la cámara para tomar fotos del problema que estás reportando.",
        "NSPhotoLibraryUsageDescription": "Usamos tu galería para adjuntar fotos del problema reportado."
      }
    },
    "android": {
      "package": "com.alertabaches.miapp",
      "adaptiveIcon": {
        "backgroundColor": "#1c1f24",
        "foregroundImage": "./assets/images/logo_app.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo_app.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para marcar el punto exacto del reporte en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tu galería para adjuntar fotos del problema reportado.",
          "cameraPermission": "Usamos la cámara para tomar fotos del problema que estás reportando."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d909365c-e1a1-450a-95d4-cbedbd672fff"
      }
    },
    "owner": "kamilita"
  }
}
